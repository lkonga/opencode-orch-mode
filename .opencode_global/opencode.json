{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/grok-code-fast-1",
  "small_model": "github-copilot/gpt-4.1",
  "disabled_providers": [
    "deepseek",
    "anthropic",
    "openai",
    "cerebras",
    "fireworks",
    "groq",
    "moonshot",
    "together",
    "xai",
    "azure-openai",
    "amazon-bedrock",
    "lmstudio",
    "ollama",
    "openrouter"
  ],
  "mcp": {
    "markitdown": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.12",
        "--from",
        "markitdown-mcp==0.0.1a4",
        "markitdown-mcp"
      ],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server",
        "--brave-api-key",
        "{env:BRAVE_SEARCH_API_KEY}"
      ],
      "environment": {},
      "enabled": true
    },
    "time": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-time",
        "--local-timezone=Asia/Bangkok"
      ],
      "enabled": true
    },
    "searxng-search": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.11",
        "--with",
        "fastmcp",
        "--with",
        "httpx",
        "--from",
        "fastmcp",
        "python",
        "/home/lkonga/codes/llm-rules/mcp-docker/scripts/searxng-remote-fastmcp.py"
      ],
      "environment": {
        "SEARXNG_HOST": "192.168.1.100",
        "SEARXNG_PORT": "11236",
        "SEARXNG_SSH_HOST": "g5kc_lan",
        "SEARXNG_CONTAINER": "mcp-searxng",
        "SEARXNG_AUTO_START": "true",
        "SEARXNG_MCP_DEFAULT_RESULT_COUNT": "10",
        "SEARXNG_MCP_DEFAULT_LANGUAGE": "all"
      },
      "enabled": true
    },
    "crawl4ai": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.11",
        "--with",
        "fastmcp",
        "--with",
        "httpx",
        "--from",
        "fastmcp",
        "python",
        "/home/lkonga/codes/llm-rules/mcp-docker/scripts/crawl4ai-remote-fastmcp.py"
      ],
      "environment": {
        "CRAWL4AI_HOST": "192.168.1.100",
        "CRAWL4AI_PORT": "11235",
        "CRAWL4AI_SSH_HOST": "g5kc_lan",
        "CRAWL4AI_CONTAINER": "mcp-crawl4ai",
        "CRAWL4AI_AUTO_START": "true",
        "CRAWL4AI_STARTUP_WAIT": "30",
        "CRAWL4AI_HEALTH_INTERVAL": "5"
      },
      "enabled": true
    }
  },
  "provider": {
    "zai": {
      "name": "Z.AI",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.z.ai/api/anthropic/v1",
        "apiKey": "b2442a512a7940c2bb29caba28f49c8a.KoJlYSGjsvNxUPt6"
      },
      "models": {
        "glm-4.7": {
          "id": "glm-4.7",
          "name": "GLM-4.7",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "release_date": "2025-12-01",
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "glm-4.7-thinking": {
          "id": "glm-4.7",
          "name": "GLM-4.7 Thinking",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budget_tokens": 16000
            }
          }
        },
        "glm-4.7-fast": {
          "id": "glm-4.7",
          "name": "GLM-4.7 Fast",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "options": {
            "thinking": {
              "type": "disabled"
            }
          }
        }
      }
    },
    "chutes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chutes.ai",
      "options": {
        "baseURL": "https://llm.chutes.ai/v1",
        "apiKey": "{env:CHUTES_API_TOKEN}"
      },
      "models": {
        "zai-org/GLM-4.5-turbo": {},
        "moonshotai/Kimi-K2-Instruct-0905": {},
        "Qwen/Qwen3-Coder-480B-A35B-Instruct-FP8": {}
      }
    },
    "opencode": {
      "models": {
        "grok-code": {}
      }
    },
    "local-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Qwen 3",
      "options": {
        "baseURL": "http://localhost:8088/v1"
      },
      "models": {
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus (Local)"
        }
      }
    },
    "local-copilot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Copilot",
      "options": {
        "baseURL": "http://localhost:15432"
      },
      "models": {
        "grok-code-fast-1": {
          "name": "Grok Code Fast 1 (Local)"
        },
        "gpt-4.1": {
          "name": "GPT-4.1 (Local)"
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini (Local)"
        }
      }
    },
    "github-copilot": {
      "models": {
        "gpt-4.1": {},
        "gpt-5-mini": {},
        "grok-code-fast-1": {}
      }
    },
    "google": {
      "name": "Google Gemini (local)",
      "options": {
        "baseURL": "http://localhost:8001/v1beta",
        "apiKey": "dev-token",
        "debug": true
      },
      "models": {
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "limit": {
            "context": 125000,
            "output": 4096
          },
          "options": {
            "useSearchGrounding": true
          }
        }
      }
    }
  },
  "agent": {
    "general": {
      "model": "zai/glm-4.7",
      "description": "General-purpose agent for researching and multi-step tasks"
    },
    "build": {
      "model": "zai/glm-4.7",
      "description": "Build agent with reasoning enabled for complex development tasks"
    },
    "expert": {
      "description": "Expert subagent with thinking enabled for complex tasks requiring deep reasoning and analysis. Use for architectural decisions, complex refactoring, debugging difficult issues, and tasks requiring thorough analysis.",
      "mode": "subagent",
      "model": "zai/glm-4.7-thinking"
    },
    "normal": {
      "description": "Normal subagent with thinking disabled for routine tasks and quick operations. Use for simple searches, straightforward code changes, file operations, and tasks that don't require deep reasoning.",
      "mode": "subagent",
      "model": "zai/glm-4.7-fast"
    }
  },
  "default_agent": "general",
  "keybinds": {
    "app_exit": "<leader>q",
    "leader": "ctrl+x"
  },
  "theme": "catppuccin"
}
