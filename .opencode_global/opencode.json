{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/grok-code-fast-1",
  "small_model": "github-copilot/gpt-4.1",
  "disabled_providers": [
    "deepseek",
    "anthropic",
    "openai",
    "cerebras",
    "fireworks",
    "groq",
    "moonshot",
    "together",
    "xai",
    "azure-openai",
    "amazon-bedrock",
    "lmstudio",
    "ollama",
    "openrouter"
  ],
  "mcp": {
    "markitdown": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.12",
        "--from",
        "markitdown-mcp==0.0.1a4",
        "markitdown-mcp"
      ],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server",
        "--brave-api-key",
        "{env:BRAVE_SEARCH_API_KEY}"
      ],
      "environment": {},
      "enabled": true
    },
    "time": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-time",
        "--local-timezone=Asia/Bangkok"
      ],
      "enabled": true
    },
    "searxng-search": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.11",
        "--with",
        "fastmcp",
        "--with",
        "httpx",
        "--from",
        "fastmcp",
        "python",
        "/home/lkonga/codes/llm-rules/mcp-docker/scripts/searxng-remote-fastmcp.py"
      ],
      "environment": {
        "SEARXNG_HOST": "192.168.1.100",
        "SEARXNG_PORT": "11236",
        "SEARXNG_SSH_HOST": "g5kc_lan",
        "SEARXNG_CONTAINER": "mcp-searxng",
        "SEARXNG_AUTO_START": "true",
        "SEARXNG_MCP_DEFAULT_RESULT_COUNT": "10",
        "SEARXNG_MCP_DEFAULT_LANGUAGE": "all"
      },
      "enabled": true
    },
    "crawl4ai": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.11",
        "--with",
        "fastmcp",
        "--with",
        "httpx",
        "--from",
        "fastmcp",
        "python",
        "/home/lkonga/codes/llm-rules/mcp-docker/scripts/crawl4ai-remote-fastmcp.py"
      ],
      "environment": {
        "CRAWL4AI_HOST": "192.168.1.100",
        "CRAWL4AI_PORT": "11235",
        "CRAWL4AI_SSH_HOST": "g5kc_lan",
        "CRAWL4AI_CONTAINER": "mcp-crawl4ai",
        "CRAWL4AI_AUTO_START": "true",
        "CRAWL4AI_STARTUP_WAIT": "30",
        "CRAWL4AI_HEALTH_INTERVAL": "5"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": false
    }
  },
  "provider": {
    "chutes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chutes.ai",
      "options": {
        "baseURL": "https://llm.chutes.ai/v1",
        "apiKey": "{env:CHUTES_API_TOKEN}"
      },
      "models": {
        "zai-org/GLM-4.5-turbo": {},
        "moonshotai/Kimi-K2-Instruct-0905": {},
        "Qwen/Qwen3-Coder-480B-A35B-Instruct-FP8": {},
        "MiniMaxAI/MiniMax-M2.1-TEE": {
          "options": {
            "temperature": 1.0,
            "topP": 0.95,
            "topK": 40
          }
        }
      }
    },
    "zai-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "b2442a512a7940c2bb29caba28f49c8a.KoJlYSGjsvNxUPt6"
      },
      "models": {
        "glm-4.7": {
          "options": {
            "topP": 0.95,
            "temperature": 0.7
          }
        }
      }
    },
    "opencode": {
      "models": {
        "grok-code": {}
      }
    },
    "local-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Qwen 3",
      "options": {
        "baseURL": "http://localhost:8088/v1"
      },
      "models": {
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus (Local)"
        }
      }
    },
    "local-copilot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Copilot",
      "options": {
        "baseURL": "http://localhost:15432"
      },
      "models": {
        "grok-code-fast-1": {
          "name": "Grok Code Fast 1 (Local)"
        },
        "gpt-4.1": {
          "name": "GPT-4.1 (Local)"
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini (Local)"
        }
      }
    },
    "github-copilot": {
      "models": {
        "gpt-4.1": {},
        "gpt-5-mini": {},
        "gpt-5.2": {
          "options": {
            "temperature": 0
          }
        },
        "grok-code-fast-1": {}
      }
    },
    "google": {
      "name": "Google Gemini (local)",
      "options": {
        "baseURL": "http://localhost:8001/v1beta",
        "apiKey": "dev-token",
        "debug": true
      },
      "models": {
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "limit": {
            "context": 125000,
            "output": 4096
          },
          "options": {
            "useSearchGrounding": true
          }
        }
      }
    }
  },
  "agent": {
    "general": {
      "model": "zai-coding-plan/glm-4.7",
      "description": "General-purpose agent"
    },
    "build": {
      "model": "zai-coding-plan/glm-4.7",
      "description": "Build agent for development tasks"
    },
    "expert": {
      "description": "Expert subagent for complex tasks requiring deep reasoning and analysis. Use for architectural decisions, complex refactoring, debugging difficult issues, and tasks requiring thorough analysis.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.2"
    },
    "normal": {
      "description": "Normal subagent for routine tasks and quick operations. Use for simple searches, straightforward code changes, file operations, and tasks that don't require deep reasoning.",
      "mode": "subagent",
      "model": "zai-coding-plan/glm-4.7"
    },
    "explore": {
      "description": "Codebase discovery agent for parallel discovery - analyzes structure, finds patterns, identifies modification targets",
      "mode": "subagent",
      "model": "chutes/MiniMaxAI/MiniMax-M2.1-TEE"
    },
    "coder": {
      "description": "Implementation specialist for executing development plans and code modifications. Delegates to @explore for context discovery.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.2"
    },
    "repositoryAnalyst": {
      "description": "Deep codebase analyst with ultrathink - comprehensive analysis, architectural reviews, long-form reasoning",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.2"
    },
    "reviewer": {
      "description": "Comprehensive code reviewer - detailed reviews with thorough analysis and enhanced assessment",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.2"
    },
    "summarizer": {
      "description": "Session summarizer - condenses subagent sessions for main agent orchestration",
      "mode": "subagent",
      "model": "chutes/MiniMaxAI/MiniMax-M2.1-TEE"
    },
    "PromptEnhancer": {
      "description": "Expert metaprompter - enhances prompts with context, clarity, and detail for high-quality subagent tasks",
      "mode": "subagent",
      "model": "chutes/MiniMaxAI/MiniMax-M2.1-TEE"
    },
    "quickReviewer": {
      "description": "Rapid first-pass reviewer - fast assessments for initial validation and quick feedback",
      "mode": "subagent",
      "model": "chutes/MiniMaxAI/MiniMax-M2.1-TEE"
    }
  },
  "default_agent": "general",
  "keybinds": {
    "app_exit": "<leader>q",
    "leader": "ctrl+x"
  },
  "theme": "catppuccin"
}